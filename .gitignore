# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 내부 작업 문서 (PRD, 블로그 초안 등) — 웹 배포 대상 아님
Claude/
*.docx
네이버블로그_*.md
홍보글_*.md
이력서.md
council_*.md
유입_설정_기준선.md
블로그_*.md
러닝업계_진입점_검토.md

# 스크래핑 임시 결과물 — 남의 페이지 본문이라 저장소에 넣지 않는다
coupang*.md
coupang*.html
scrape_*.md
scrape_*.html

# 대조표 산출물 — 저장소에 넣지 않는다
outputs/

# 화면 캡처 — Claude 가 읽는 용도다. 저장소에 넣을 이유가 없다(큰 바이너리).
# 폴더 자체는 로컬에 남으므로 Claude 는 파일을 그대로 읽는다.
shots/
# Overpass 원본 응답 캐시 — 다시 받지 않기 위한 것이다
.cache/
